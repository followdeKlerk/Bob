    "name": "packing",
    "html": "<style>*{box-sizing:border-box}body{margin:0;padding:12px;background:#141d24;color:#f1f6f8;font:16px/1.4 system-ui,sans-serif}.rows{display:grid;gap:8px}label{display:flex;align-items:center;gap:12px;padding:10px 12px;min-height:46px;border:1px solid #3b4c57;border-radius:10px;background:#1d2a33}input{width:22px;height:22px;margin:0;flex:none;accent-color:#8ce0b4}#extras{margin-top:8px}[hidden]{display:none!important}button{display:block;width:100%;min-height:46px;margin-top:12px;padding:10px 12px;border:1px solid #72b994;border-radius:10px;background:#254a3a;color:#e8fff0;font:600 16px/1.4 system-ui,sans-serif}button:focus-visible{outline:2px solid #9df1c3;outline-offset:2px}</style><div class=\"rows\"><label><input type=\"checkbox\"><span>Phone charger</span></label><label><input type=\"checkbox\"><span>Water bottle</span></label></div><div id=\"extras\" class=\"rows\" hidden><label><input type=\"checkbox\"><span>Headphones</span></label><label><input type=\"checkbox\"><span>Light jacket</span></label></div><button id=\"toggle\" type=\"button\" aria-controls=\"extras\" aria-expanded=\"false\">Show 2 more</button><script>const toggle=document.getElementById('toggle'),extras=document.getElementById('extras');toggle.addEventListener('click',()=>{const expanded=extras.hidden;extras.hidden=!expanded;toggle.setAttribute('aria-expanded',String(expanded));toggle.textContent=expanded?'Show less':'Show 2 more';});</script>"
  },
  {
    "name": "progress",
    "visualData": {
      "revision": 1,
      "data": {
        "progress": 35,
        "stage": "Ready to build",
        "items": [
          "Scope agreed",
