<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/nordwand_mono</item>
        <item name="fontFamily">@font/nordwand_mono</item>
        <item name="android:scrollbars">none</item>
        <item name="android:editTextStyle">@style/BobEditText</item>
        <item name="editTextStyle">@style/BobEditText</item>
        <item name="android:scrollViewStyle">@style/BobScrollView</item>
        <item name="android:horizontalScrollViewStyle">@style/BobHorizontalScrollView</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Edge-to-edge drawer content supplies its own fade behind the controls;
             do not add Android's separate opaque navigation contrast scrim. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:textColorPrimary">#f4f4f5</item>
        <item name="android:textColorSecondary">#f4f4f5</item>
        <item name="colorAccent">#f4f4f5</item>
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <style name="BobEditText" parent="Widget.AppCompat.EditText">
        <item name="android:scrollbars">none</item>
    </style>
    <style name="BobScrollView" parent="android:style/Widget.ScrollView">
        <item name="android:scrollbars">none</item>
    </style>
    <style name="BobHorizontalScrollView" parent="android:style/Widget">
        <item name="android:scrollbars">none</item>
    </style>
</resources>
